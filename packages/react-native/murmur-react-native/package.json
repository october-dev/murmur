{
  "name": "@october-dev/murmur-react-native",
  "version": "0.1.0",
  "description": "Native Murmur bindings for Expo and React Native apps on iOS and Android.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/october-dev/murmur.git",
    "directory": "packages/react-native/murmur-react-native"
  },
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    }
  },
  "files": [
    "android",
    "ios",
    "build",
    "app.plugin.js",
    "expo-module.config.json",
