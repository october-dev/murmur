  ],
  "scripts": {
    "build": "expo-module build",
    "clean": "expo-module clean",
    "prepare": "expo-module prepare",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@october-dev/murmur-protocol": "0.1.0"
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "expo": "*",
    "expo-module-scripts": "^56.0.3",
    "react": "*",
    "react-native": "*",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
