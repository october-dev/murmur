{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://murmur.dev/schema/connector-manifest-v1.json",
  "title": "Murmur connector manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "protocolMajor",
    "status",
    "transports",
    "capabilities",
    "implementation",
    "platforms",
    "licenses"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+].+)?$" },
    "protocolMajor": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["experimental", "supported", "deprecated"] },
    "transports": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "capabilities": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "sdk", "path"],
      "properties": {
        "language": { "type": "string", "minLength": 1 },
        "sdk": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "platforms": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "licenses": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 },
      "minProperties": 1
    }
  }
}
